{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tasks board (live)",
      "detail": "Keeps agents/tasks-board.md up to date from the registers; open its Markdown preview",
      "type": "shell",
      "command": "uv run ../tools/brain/action.py board --write --watch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
