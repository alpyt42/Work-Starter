# Separate repositories and local work (every root brain: brain/, brain-perso/, brain-*/)
/brain*/
/repos/*
!/repos/README.md
!/repos/workspaces/
/repos/workspaces/*
!/repos/workspaces/README.md
/artifacts/*
!/artifacts/README.md
/agents/*
!/agents/README.md
# Local editor settings (Todo Tree filters on the brain owner's name)
/.vscode/

# Skills exposed to agents and files generated from the work config (work-config.example.json
# and each brain's .data/work-config.json are the versioned sources)
/.agents/
/.claude/skills/
/skills-lock.json
/.work-state.json
/work-config.local.json

# Local settings, secrets, and caches
/.claude/settings.local.json
.env
.env.*
!.env.example
__pycache__/
*.pyc
.DS_Store

__azurite_*.json

# Obsidian is configured by hand on each machine and never tracked (see kit/obsidian/README.md)
/.obsidian/
/.trash/
